model video {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  staff_id String @db.VarChar(100)
  course   String @db.VarChar(100)
  class    String @db.VarChar(100)
  link     String @db.VarChar(100)
  date     String @db.VarChar(100)
  updated  String @db.VarChar(100)
}

enum school_fees_payment_status {
  pending
  success
  failed
}
