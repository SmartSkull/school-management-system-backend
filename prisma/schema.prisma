// Target normalized schema for Florieren.
// This is a clean design to migrate toward. It should not be applied directly
// to the existing production database without a data migration plan.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  ARCHIVED
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  ISSUED
  PAID
}

model School {
  id             BigInt        @id @default(autoincrement())
  name           String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(100)
  slogan         String?       @db.VarChar(255)
  motto          String?       @db.VarChar(255)
  description    String?       @db.Text
  email          String?       @unique @db.VarChar(255)
  contactEmail   String?       @db.VarChar(255)
  contactName    String?       @db.VarChar(150)
  telephone      String?       @db.VarChar(50)
  alternatePhone String?       @db.VarChar(50)
  address        String?       @db.Text
  city           String?       @db.VarChar(100)
  state          String?       @db.VarChar(100)
  country        String?       @default("Nigeria") @db.VarChar(100)
  website        String?       @db.VarChar(255)
  logo           String?       @db.VarChar(255)
  primaryColor   String        @default("#1a73e8") @db.VarChar(20)
  secondaryColor String        @default("#ffffff") @db.VarChar(20)
  accentColor    String        @default("#84cc16") @db.VarChar(20)
  status         AccountStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users               User[]
  classes             ClassRoom[]
  sessions            AcademicSession[]
  attendanceLocations AttendanceLocation[]
  leaveEntitlements   LeaveEntitlement[]
  payrollDeductions   PayrollDeduction[]
  incomes             Income[]
  expenses            Expense[]
  hostels             Hostel[]
  books               Book[]
  transportRoutes     TransportRoute[]
  transportDrivers    TransportDriver[]
  transportBuses      TransportBus[]
}

model User {
  id           BigInt        @id @default(autoincrement())
  schoolId     BigInt?
  role         UserRole
  uniqueId     String        @unique @db.VarChar(100)
  firstName    String        @db.VarChar(100)
  middleName   String?       @db.VarChar(100)
  lastName     String        @db.VarChar(100)
  email        String?       @db.VarChar(255)
  telephone    String?       @db.VarChar(50)
  password     String        @db.VarChar(255)
  image        String?       @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  verifiedAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school       School?       @relation(fields: [schoolId], references: [id])
  student      Student?
  staff        Staff?
  notifications Notification[]
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  sentMessages Message[]     @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  clockAttendances StudentAttendance[]
  transportDriver  TransportDriver?
}

model Student {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @unique
  studentNo       String    @unique @db.VarChar(100)
  classRoomId     BigInt?
  admissionYear   String?   @db.VarChar(20)
  dateOfBirth     DateTime?
  stateOfOrigin   String?   @db.VarChar(100)
  homeAddress     String?   @db.Text
  parentEmail     String?   @db.VarChar(255)
  parentLat       Decimal?  @db.Decimal(10,7)
  parentLng       Decimal?  @db.Decimal(10,7)
  fatherName      String?   @db.VarChar(150)
  motherName      String?   @db.VarChar(150)
  parentImage     String?   @db.VarChar(255)
  about           String?   @db.Text
  religion        String?   @db.VarChar(50)
  bloodGroup      String?   @db.VarChar(10)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRoom       ClassRoom? @relation(fields: [classRoomId], references: [id])
  results         Result[]
  attendance      Attendance[]
  feePayments     SchoolFeePayment[]
  cbtAnswers      CbtAnswer[]
  cbtResults      CbtResult[]
  scratchCards    ScratchCard[]
  traits          StudentTrait[]
  hostelBed       HostelBed?
  hostelAttendances HostelAttendance[]
  bookBorrows     BookBorrow[]
  transportAssignment TransportAssignment?
}

model Staff {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @unique
  staffNo       String    @unique @db.VarChar(100)
  staffRole     String?   @db.VarChar(50)
  stateOfOrigin String?   @db.VarChar(100)
  dateOfBirth   DateTime?
  homeAddress   String?   @db.Text
  about         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRooms    ClassRoom[] @relation("ClassTeacher")
  subjects      Subject[]
  assignments   Assignment[]
  resources     LibraryResource[]
  results       Result[]
  questions     CbtQuestion[]
  classTimetables ClassTimetable[]
  examTimetables  ExamTimetable[]
  staffAttendances StaffAttendance[]
  leaveRequests   LeaveRequest[]
  salarySetup     PayrollSalarySetup?
  payrollDeductions PayrollDeduction[]
  payslips        PayrollPayslip[]
  curriculumTopics CurriculumTopic[]
  lessonPlans     LessonPlan[]
  weeklySchemes   WeeklyScheme[]
}

model AcademicSession {
  id        BigInt   @id @default(autoincrement())
  schoolId  BigInt?
  name      String   @unique @db.VarChar(20)
  startsAt  DateTime?
  endsAt    DateTime?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School?  @relation(fields: [schoolId], references: [id])
  terms     AcademicTerm[]
  results   Result[]
  attendance Attendance[]
  feeConfigs SchoolFeeConfig[]
  feePayments SchoolFeePayment[]
  scratchCards ScratchCard[]
  cbtTests  CbtTest[]
  traits    StudentTrait[]
}

model AcademicTerm {
  id         BigInt          @id @default(autoincrement())
  sessionId  BigInt
  name       TermName
  startsAt   DateTime?
  endsAt     DateTime?
  totalDays  Int             @default(0)
  isCurrent  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results    Result[]
  attendance Attendance[]
  feeConfigs SchoolFeeConfig[]
  feePayments SchoolFeePayment[]
  scratchCards ScratchCard[]
  cbtTests  CbtTest[]
  traits    StudentTrait[]

  @@unique([sessionId, name])
}

model ClassRoom {
  id             BigInt   @id @default(autoincrement())
  schoolId       BigInt?
  name           String   @unique @db.VarChar(100)
  classTeacherId BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School?  @relation(fields: [schoolId], references: [id])
  classTeacher   Staff?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students       Student[]
  subjects       Subject[]
  assignments    Assignment[]
  feeConfigs     SchoolFeeConfig[]
  cbtTests       CbtTest[]
  classTimetables ClassTimetable[]
  scratchCards   ScratchCard[]
  libraryResources LibraryResource[]
  curriculumTopics CurriculumTopic[]
  lessonPlans    LessonPlan[]
  weeklySchemes  WeeklyScheme[]
}

model Subject {
  id          BigInt    @id @default(autoincrement())
  classRoomId BigInt?
  teacherId   BigInt?
  name        String    @db.VarChar(150)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  teacher     Staff?     @relation(fields: [teacherId], references: [id])
  results     Result[]
  assignments Assignment[]
  resources   LibraryResource[]
  cbtTests    CbtTest[]
  questions   CbtQuestion[]
  curriculumTopics CurriculumTopic[]
  lessonPlans LessonPlan[]
  weeklySchemes WeeklyScheme[]

  @@unique([classRoomId, name])
}

model Result {
  id          BigInt   @id @default(autoincrement())
  studentId   BigInt
  subjectId   BigInt
  teacherId   BigInt?
  sessionId   BigInt
  termId      BigInt
  testScore   Decimal  @default(0) @db.Decimal(5, 2)
  examScore   Decimal  @default(0) @db.Decimal(5, 2)
  totalScore  Decimal  @default(0) @db.Decimal(5, 2)
  grade       String?  @db.VarChar(10)
  remark      String?  @db.VarChar(255)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacher     Staff?   @relation(fields: [teacherId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  term        AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, sessionId, termId])
}

model Attendance {
  id               BigInt   @id @default(autoincrement())
  studentId         BigInt
  sessionId         BigInt
  termId            BigInt
  present           Int      @default(0)
  absent            Int      @default(0)
  teacherComment   String?  @db.Text
  principalComment  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session           AcademicSession @relation(fields: [sessionId], references: [id])
  term              AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, sessionId, termId])
}

model StudentTrait {
  id          BigInt   @id @default(autoincrement())
  studentId   BigInt
  sessionId   BigInt
  termId      BigInt
  // Affective traits (0-5)
  punctuality    Int @default(0)
  perseverance   Int @default(0)
  responsibility Int @default(0)
  diligence      Int @default(0)
  selfControl    Int @default(0)
  honesty        Int @default(0)
  attendance     Int @default(0)
  attentiveness  Int @default(0)
  creativity     Int @default(0)
  curiosity      Int @default(0)
  // Psychomotor traits (0-5)
  drawing        Int @default(0)
  physicalActivity Int @default(0)
  accuracy       Int @default(0)
  handlingOfTools Int @default(0)
  mentalSkills   Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  term        AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, sessionId, termId])
}

model Assignment {
  id          BigInt    @id @default(autoincrement())
  staffId     BigInt
  classRoomId BigInt?
  subjectId   BigInt?
  title       String    @db.VarChar(255)
  content     String    @db.Text
  file        String?   @db.VarChar(255)
  status      String    @default("PUBLISHED") @db.VarChar(20)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staff       Staff     @relation(fields: [staffId], references: [id])
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  subject     Subject?  @relation(fields: [subjectId], references: [id])
}

model LibraryResource {
  id             BigInt   @id @default(autoincrement())
  staffId        BigInt
  subjectId      BigInt
  classRoomId    BigInt?
  title          String   @db.VarChar(200)
  description    String?  @db.Text
  file           String   @db.VarChar(200)
  status         ResourceStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff          Staff     @relation(fields: [staffId], references: [id])
  subject        Subject   @relation(fields: [subjectId], references: [id])
  classRoom      ClassRoom? @relation(fields: [classRoomId], references: [id])
}

model SchoolFeeConfig {
  id          BigInt   @id @default(autoincrement())
  classRoomId BigInt
  sessionId   BigInt
  termId      BigInt
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  term        AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([classRoomId, sessionId, termId])
}

model SchoolFeePayment {
  id                 BigInt        @id @default(autoincrement())
  studentId           BigInt
  sessionId           BigInt
  termId              BigInt
  amount              Decimal       @db.Decimal(10, 2)
  reference           String        @unique @db.VarChar(150)
  paystackAccessCode  String?       @db.VarChar(255)
  status              PaymentStatus @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  student             Student       @relation(fields: [studentId], references: [id])
  session             AcademicSession @relation(fields: [sessionId], references: [id])
  term                AcademicTerm @relation(fields: [termId], references: [id])
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      NotificationType @default(INFO)
  title     String?          @db.VarChar(255)
  message   String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        BigInt    @id @default(autoincrement())
  authorId  BigInt
  text      String    @db.Text
  image     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt
  authorId  BigInt
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model Like {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt
  userId    BigInt
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Message {
  id         BigInt   @id @default(autoincrement())
  senderId   BigInt
  receiverId BigInt
  body       String   @db.Text
  readAt     DateTime?
  deletedAt  DateTime?
  editedAt   DateTime?
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model CbtTest {
  id          BigInt        @id @default(autoincrement())
  classRoomId BigInt?
  subjectId   BigInt?
  sessionId   BigInt?
  termId      BigInt?
  title       String        @db.VarChar(255)
  durationMin Int           @default(30)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  classRoom   ClassRoom?      @relation(fields: [classRoomId], references: [id])
  subject     Subject?        @relation(fields: [subjectId], references: [id])
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  term        AcademicTerm?   @relation(fields: [termId], references: [id])
  questions   CbtQuestion[]
  results     CbtResult[]
}

model CbtQuestion {
  id          BigInt   @id @default(autoincrement())
  testId      BigInt
  staffId     BigInt?
  subjectId   BigInt?
  question    String   @db.Text
  optionA     String   @db.Text
  optionB     String   @db.Text
  optionC     String?  @db.Text
  optionD     String?  @db.Text
  answer      String   @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  test        CbtTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  staff       Staff?   @relation(fields: [staffId], references: [id])
  subject     Subject? @relation(fields: [subjectId], references: [id])
  answers     CbtAnswer[]
}

model CbtAnswer {
  id          BigInt      @id @default(autoincrement())
  studentId   BigInt
  questionId  BigInt
  selected    String      @db.VarChar(10)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])
  question    CbtQuestion @relation(fields: [questionId], references: [id])

  @@unique([studentId, questionId])
}

model CbtResult {
  id          BigInt   @id @default(autoincrement())
  testId      BigInt
  studentId   BigInt
  score       Decimal  @db.Decimal(5, 2)
  percentage  Decimal  @db.Decimal(5, 2)
  submittedAt DateTime @default(now())

  test        CbtTest  @relation(fields: [testId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([testId, studentId])
}
model SchoolDays {
  id         BigInt   @id @default(autoincrement())
  session    String   @db.VarChar(20)
  term       String   @db.VarChar(20)
  totalDays  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([session, term])
}

model ClassTimetable {
  id          BigInt   @id @default(autoincrement())
  staffId     BigInt?
  classRoomId BigInt
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff?    @relation(fields: [staffId], references: [id])
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])
}

model ExamTimetable {
  id        BigInt   @id @default(autoincrement())
  staffId   BigInt?
  level     String   @db.VarChar(50) // junior/senior
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff?   @relation(fields: [staffId], references: [id])
}

model AttendanceLocation {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt
  name        String   @db.VarChar(150)
  latitude    Float
  longitude   Float
  radiusMeters Int     @default(100)
  resumptionTime String @default("08:00") @db.VarChar(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school           School   @relation(fields: [schoolId], references: [id])
  attendances      StaffAttendance[]
  studentAttendances StudentAttendance[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model StaffAttendance {
  id           BigInt            @id @default(autoincrement())
  staffId      BigInt
  locationId   BigInt?
  date         DateTime          @db.Date
  clockIn      DateTime?
  clockOut     DateTime?
  status       AttendanceStatus  @default(PRESENT)
  lateMinutes  Int               @default(0)
  note         String?           @db.VarChar(255)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location     AttendanceLocation? @relation(fields: [locationId], references: [id])

  @@unique([staffId, date])
}

model StudentAttendance {
  id           BigInt            @id @default(autoincrement())
  studentId    String            @db.VarChar(100)
  locationId   BigInt?
  date         DateTime          @db.Date
  clockIn      DateTime?
  clockOut     DateTime?
  status       AttendanceStatus  @default(PRESENT)
  lateMinutes  Int               @default(0)
  note         String?           @db.VarChar(255)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student      User              @relation(fields: [studentId], references: [uniqueId], onDelete: Cascade)
  location     AttendanceLocation? @relation(fields: [locationId], references: [id])

  @@unique([studentId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

model LeaveEntitlement {
  id       BigInt    @id @default(autoincrement())
  schoolId BigInt
  type     LeaveType
  days     Int       @default(0)
  updatedAt DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, type])
}

model LeaveRequest {
  id          BigInt      @id @default(autoincrement())
  staffId     BigInt
  type        LeaveType   @default(OTHER)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  days        Int
  reason      String      @db.Text
  proofFile   String?     @db.VarChar(255)
  status      LeaveStatus @default(PENDING)
  adminNote   String?     @db.Text
  reviewedAt  DateTime?
  reviewedBy  BigInt?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model ScratchCard {
  id             BigInt   @id @default(autoincrement())
  studentId      BigInt
  classRoomId    BigInt?
  amount         Decimal  @db.Decimal(10, 2)
  reference      String?  @db.VarChar(150)
  status         String   @default("pending") @db.VarChar(50)
  sessionId      BigInt?
  termId         BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id])
  classRoom      ClassRoom? @relation(fields: [classRoomId], references: [id])
  session        AcademicSession? @relation(fields: [sessionId], references: [id])
  term           AcademicTerm? @relation(fields: [termId], references: [id])
}

model PayrollSalarySetup {
  id                 BigInt   @id @default(autoincrement())
  staffId            BigInt   @unique
  basicSalary        Decimal  @db.Decimal(12, 2)
  housingAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal  @default(0) @db.Decimal(12, 2)
  otherAllowance     Decimal  @default(0) @db.Decimal(12, 2)
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  pensionRate        Decimal  @default(0) @db.Decimal(5, 2)
  effectiveFrom      DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model PayrollDeduction {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt
  staffId     BigInt?
  title       String   @db.VarChar(150)
  amount      Decimal  @db.Decimal(12, 2)
  recurring   Boolean  @default(false)
  month       Int?
  year        Int?
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model PayrollPayslip {
  id                 BigInt        @id @default(autoincrement())
  staffId            BigInt
  month              Int
  year               Int
  basicSalary        Decimal       @db.Decimal(12, 2)
  housingAllowance   Decimal       @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal       @default(0) @db.Decimal(12, 2)
  otherAllowance     Decimal       @default(0) @db.Decimal(12, 2)
  grossPay           Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  pensionAmount      Decimal       @default(0) @db.Decimal(12, 2)
  deductions         Decimal       @default(0) @db.Decimal(12, 2)
  netPay             Decimal       @db.Decimal(12, 2)
  status             PayrollStatus @default(ISSUED)
  generatedAt        DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  staff              Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
  @@index([year, month])
}


model CurriculumTopic {
  id          BigInt   @id @default(autoincrement())
  staffId     BigInt
  subjectId   BigInt?
  classRoomId BigInt?
  title       String   @db.VarChar(255)
  description String?  @db.Text
  week        Int?
  term        String?  @db.VarChar(20)
  session     String?  @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  lessonPlans LessonPlan[]
}

model LessonPlan {
  id          BigInt          @id @default(autoincrement())
  staffId     BigInt
  topicId     BigInt?
  subjectId   BigInt?
  classRoomId BigInt?
  title       String          @db.VarChar(255)
  objectives  String?         @db.Text
  content     String?         @db.Text
  resources   String?         @db.Text
  evaluation  String?         @db.Text
  date        DateTime?       @db.Date
  duration    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  staff       Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  topic       CurriculumTopic? @relation(fields: [topicId], references: [id])
  subject     Subject?        @relation(fields: [subjectId], references: [id])
  classRoom   ClassRoom?      @relation(fields: [classRoomId], references: [id])
}

model WeeklyScheme {
  id          BigInt   @id @default(autoincrement())
  staffId     BigInt
  subjectId   BigInt?
  classRoomId BigInt?
  week        Int
  term        String   @db.VarChar(20)
  session     String   @db.VarChar(20)
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])

  @@unique([staffId, subjectId, classRoomId, week, term, session])
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model OnlineClass {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(255)
  className       String   @db.VarChar(100)
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  roomName        String   @db.VarChar(255)
  roomUrl         String   @db.VarChar(500)
  schoolId        BigInt
  staffId         BigInt
  createdAt       DateTime @default(now())
}

model Income {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @db.VarChar(100)
  reference   String?  @db.VarChar(150)
  description String?  @db.Text
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Expense {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @db.VarChar(100)
  reference   String?  @db.VarChar(150)
  description String?  @db.Text
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Hostel {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?
  name        String   @db.VarChar(150)
  gender      String   @default("MIXED") @db.VarChar(10)
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?  @relation(fields: [schoolId], references: [id])
  rooms       HostelRoom[]
}

model HostelRoom {
  id          BigInt   @id @default(autoincrement())
  hostelId    BigInt
  name        String   @db.VarChar(100)
  capacity    Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostel      Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds        HostelBed[]
}

model HostelBed {
  id          BigInt   @id @default(autoincrement())
  roomId      BigInt
  bedNumber   String   @db.VarChar(20)
  studentId   BigInt?  @unique
  assignedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student     Student?   @relation(fields: [studentId], references: [id])

  @@unique([roomId, bedNumber])
}

model HostelAttendance {
  id          BigInt   @id @default(autoincrement())
  studentId   BigInt
  date        DateTime @db.Date
  present     Boolean  @default(true)
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Book {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?
  title       String   @db.VarChar(200)
  author      String   @db.VarChar(150)
  isbn        String?  @db.VarChar(50)
  barcode     String?  @unique @db.VarChar(100)
  category    String?  @db.VarChar(100)
  copies      Int      @default(1)
  available   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?  @relation(fields: [schoolId], references: [id])
  borrows     BookBorrow[]
}

model BookBorrow {
  id          BigInt    @id @default(autoincrement())
  bookId      BigInt
  studentId   BigInt
  borrowedAt  DateTime  @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  fine        Decimal   @default(0) @db.Decimal(10, 2)
  finePaid    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  book        Book      @relation(fields: [bookId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
}

model TransportRoute {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  fare        Decimal  @default(0) @db.Decimal(10,2)
  polyline    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?  @relation(fields: [schoolId], references: [id])
  buses       TransportBus[]
}

model TransportDriver {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?
  userId      BigInt?  @unique
  name        String   @db.VarChar(150)
  phone       String?  @db.VarChar(30)
  licenseNo   String?  @db.VarChar(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?  @relation(fields: [schoolId], references: [id])
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  buses       TransportBus[]
}

model TransportBus {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?
  routeId     BigInt?
  driverId    BigInt?
  plateNumber String   @db.VarChar(30)
  capacity    Int      @default(40)
  gpsLat      Decimal? @db.Decimal(10,7)
  gpsLng      Decimal? @db.Decimal(10,7)
  gpsUpdatedAt DateTime?
  tripActive  Boolean  @default(false)
  tripDate    DateTime?
  driverToken String?  @unique @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?         @relation(fields: [schoolId], references: [id])
  route       TransportRoute? @relation(fields: [routeId], references: [id])
  driver      TransportDriver? @relation(fields: [driverId], references: [id])
  assignments TransportAssignment[]
}

model TransportAssignment {
  id          BigInt    @id @default(autoincrement())
  busId       BigInt
  studentId   BigInt    @unique
  alertedAt   DateTime?
  absentToday Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bus       TransportBus @relation(fields: [busId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
