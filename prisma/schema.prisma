// Target normalized schema for Florieren.
// This is a clean design to migrate toward. It should not be applied directly
// to the existing production database without a data migration plan.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  ARCHIVED
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id             BigInt        @id @default(autoincrement())
  name           String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(100)
  email          String?       @unique @db.VarChar(255)
  telephone      String?       @db.VarChar(50)
  address        String?       @db.Text
  logo           String?       @db.VarChar(255)
  primaryColor   String        @default("#1a73e8") @db.VarChar(20)
  secondaryColor String        @default("#ffffff") @db.VarChar(20)
  status         AccountStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users          User[]
  classes        ClassRoom[]
  sessions       AcademicSession[]
}

model User {
  id           BigInt        @id @default(autoincrement())
  schoolId     BigInt?
  role         UserRole
  uniqueId     String        @unique @db.VarChar(100)
  firstName    String        @db.VarChar(100)
  middleName   String?       @db.VarChar(100)
  lastName     String        @db.VarChar(100)
  email        String?       @db.VarChar(255)
  telephone    String?       @db.VarChar(50)
  password     String        @db.VarChar(255)
  image        String?       @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  verifiedAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school       School?       @relation(fields: [schoolId], references: [id])
  student      Student?
  staff        Staff?
  notifications Notification[]
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  sentMessages Message[]     @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Student {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @unique
  studentNo       String    @unique @db.VarChar(100)
  classRoomId     BigInt?
  admissionYear   String?   @db.VarChar(20)
  dateOfBirth     DateTime?
  stateOfOrigin   String?   @db.VarChar(100)
  homeAddress     String?   @db.Text
  fatherName      String?   @db.VarChar(150)
  motherName      String?   @db.VarChar(150)
  parentImage     String?   @db.VarChar(255)
  about           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRoom       ClassRoom? @relation(fields: [classRoomId], references: [id])
  results         Result[]
  attendance      Attendance[]
  feePayments     SchoolFeePayment[]
  cbtAnswers      CbtAnswer[]
  cbtResults      CbtResult[]
  scratchCards    ScratchCard[]
}

model Staff {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @unique
  staffNo       String    @unique @db.VarChar(100)
  stateOfOrigin String?   @db.VarChar(100)
  dateOfBirth   DateTime?
  homeAddress   String?   @db.Text
  about         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRooms    ClassRoom[] @relation("ClassTeacher")
  subjects      Subject[]
  assignments   Assignment[]
  resources     LibraryResource[]
  results       Result[]
  questions     CbtQuestion[]
  classTimetables ClassTimetable[]
  examTimetables  ExamTimetable[]
}

model AcademicSession {
  id        BigInt   @id @default(autoincrement())
  schoolId  BigInt?
  name      String   @unique @db.VarChar(20)
  startsAt  DateTime?
  endsAt    DateTime?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School?  @relation(fields: [schoolId], references: [id])
  terms     AcademicTerm[]
  results   Result[]
  attendance Attendance[]
  feeConfigs SchoolFeeConfig[]
  feePayments SchoolFeePayment[]
  scratchCards ScratchCard[]
}

model AcademicTerm {
  id         BigInt          @id @default(autoincrement())
  sessionId  BigInt
  name       TermName
  startsAt   DateTime?
  endsAt     DateTime?
  totalDays  Int             @default(0)
  isCurrent  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results    Result[]
  attendance Attendance[]
  feeConfigs SchoolFeeConfig[]
  feePayments SchoolFeePayment[]
  scratchCards ScratchCard[]

  @@unique([sessionId, name])
}

model ClassRoom {
  id             BigInt   @id @default(autoincrement())
  schoolId       BigInt?
  name           String   @unique @db.VarChar(100)
  classTeacherId BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School?  @relation(fields: [schoolId], references: [id])
  classTeacher   Staff?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students       Student[]
  subjects       Subject[]
  assignments    Assignment[]
  feeConfigs     SchoolFeeConfig[]
  cbtTests       CbtTest[]
  classTimetables ClassTimetable[]
  scratchCards   ScratchCard[]
  libraryResources LibraryResource[]
}

model Subject {
  id          BigInt    @id @default(autoincrement())
  classRoomId BigInt?
  teacherId   BigInt?
  name        String    @db.VarChar(150)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  teacher     Staff?     @relation(fields: [teacherId], references: [id])
  results     Result[]
  assignments Assignment[]
  resources   LibraryResource[]
  cbtTests    CbtTest[]
  questions   CbtQuestion[]

  @@unique([classRoomId, name])
}

model Result {
  id          BigInt   @id @default(autoincrement())
  studentId   BigInt
  subjectId   BigInt
  teacherId   BigInt?
  sessionId   BigInt
  termId      BigInt
  testScore   Decimal  @default(0) @db.Decimal(5, 2)
  examScore   Decimal  @default(0) @db.Decimal(5, 2)
  totalScore  Decimal  @default(0) @db.Decimal(5, 2)
  grade       String?  @db.VarChar(10)
  remark      String?  @db.VarChar(255)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacher     Staff?   @relation(fields: [teacherId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  term        AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, sessionId, termId])
}

model Attendance {
  id               BigInt   @id @default(autoincrement())
  studentId         BigInt
  sessionId         BigInt
  termId            BigInt
  present           Int      @default(0)
  absent            Int      @default(0)
  comment          String?  @db.Text
  principalComment  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session           AcademicSession @relation(fields: [sessionId], references: [id])
  term              AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, sessionId, termId])
}

model Assignment {
  id          BigInt    @id @default(autoincrement())
  staffId     BigInt
  classRoomId BigInt?
  subjectId   BigInt?
  title       String    @db.VarChar(255)
  content     String    @db.Text
  file        String?   @db.VarChar(255)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staff       Staff     @relation(fields: [staffId], references: [id])
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  subject     Subject?  @relation(fields: [subjectId], references: [id])
}

model LibraryResource {
  id             BigInt   @id @default(autoincrement())
  staffId        BigInt
  subjectId      BigInt
  classRoomId    BigInt?
  title          String   @db.VarChar(200)
  description    String?  @db.Text
  file           String   @db.VarChar(200)
  status         ResourceStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff          Staff     @relation(fields: [staffId], references: [id])
  subject        Subject   @relation(fields: [subjectId], references: [id])
  classRoom      ClassRoom? @relation(fields: [classRoomId], references: [id])
}

model SchoolFeeConfig {
  id          BigInt   @id @default(autoincrement())
  classRoomId BigInt
  sessionId   BigInt
  termId      BigInt
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  term        AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([classRoomId, sessionId, termId])
}

model SchoolFeePayment {
  id                 BigInt        @id @default(autoincrement())
  studentId           BigInt
  sessionId           BigInt
  termId              BigInt
  amount              Decimal       @db.Decimal(10, 2)
  reference           String        @unique @db.VarChar(150)
  paystackAccessCode  String?       @db.VarChar(255)
  status              PaymentStatus @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  student             Student       @relation(fields: [studentId], references: [id])
  session             AcademicSession @relation(fields: [sessionId], references: [id])
  term                AcademicTerm @relation(fields: [termId], references: [id])
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      NotificationType @default(INFO)
  title     String?          @db.VarChar(255)
  message   String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        BigInt    @id @default(autoincrement())
  authorId  BigInt
  text      String    @db.Text
  image     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt
  authorId  BigInt
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model Like {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt
  userId    BigInt
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Message {
  id         BigInt   @id @default(autoincrement())
  senderId   BigInt
  receiverId BigInt
  body       String   @db.Text
  readAt     DateTime?
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model CbtTest {
  id          BigInt        @id @default(autoincrement())
  classRoomId BigInt?
  subjectId   BigInt?
  title       String        @db.VarChar(255)
  durationMin Int           @default(30)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  classRoom   ClassRoom?    @relation(fields: [classRoomId], references: [id])
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  questions   CbtQuestion[]
  results     CbtResult[]
}

model CbtQuestion {
  id          BigInt   @id @default(autoincrement())
  testId      BigInt
  staffId     BigInt?
  subjectId   BigInt?
  question    String   @db.Text
  optionA     String   @db.Text
  optionB     String   @db.Text
  optionC     String?  @db.Text
  optionD     String?  @db.Text
  answer      String   @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  test        CbtTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  staff       Staff?   @relation(fields: [staffId], references: [id])
  subject     Subject? @relation(fields: [subjectId], references: [id])
  answers     CbtAnswer[]
}

model CbtAnswer {
  id          BigInt      @id @default(autoincrement())
  studentId   BigInt
  questionId  BigInt
  selected    String      @db.VarChar(10)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])
  question    CbtQuestion @relation(fields: [questionId], references: [id])

  @@unique([studentId, questionId])
}

model CbtResult {
  id          BigInt   @id @default(autoincrement())
  testId      BigInt
  studentId   BigInt
  score       Decimal  @db.Decimal(5, 2)
  percentage  Decimal  @db.Decimal(5, 2)
  submittedAt DateTime @default(now())

  test        CbtTest  @relation(fields: [testId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([testId, studentId])
}
model SchoolDays {
  id         BigInt   @id @default(autoincrement())
  session    String   @db.VarChar(20)
  term       String   @db.VarChar(20)
  totalDays  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([session, term])
}

model ClassTimetable {
  id          BigInt   @id @default(autoincrement())
  staffId     BigInt?
  classRoomId BigInt
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff?    @relation(fields: [staffId], references: [id])
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])
}

model ExamTimetable {
  id        BigInt   @id @default(autoincrement())
  staffId   BigInt?
  level     String   @db.VarChar(50) // junior/senior
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff?   @relation(fields: [staffId], references: [id])
}

model ScratchCard {
  id             BigInt   @id @default(autoincrement())
  studentId      BigInt
  classRoomId    BigInt?
  amount         Decimal  @db.Decimal(10, 2)
  reference      String?  @db.VarChar(150)
  status         String   @default("pending") @db.VarChar(50)
  sessionId      BigInt?
  termId         BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id])
  classRoom      ClassRoom? @relation(fields: [classRoomId], references: [id])
  session        AcademicSession? @relation(fields: [sessionId], references: [id])
  term           AcademicTerm? @relation(fields: [termId], references: [id])
}
